# Base MySQL des tests. Toute la suite en dépend.
#
# Copier ce fichier en .env.test, puis créer la base :
#
#   mysql -u root -p -e "CREATE DATABASE falcon_analytics_test"
#
# Le nom DOIT se terminer par « _test ». Le code refuse tout le reste, et ce
# n'est pas une précaution de style : la suite migre à neuf, donc elle efface
# toutes les tables de la base qu'on lui désigne. Aucune attention portée au
# fichier ne protège aussi bien qu'une règle que le code refuse d'enfreindre.
#
# Elle ne devine jamais une base à partir de la configuration du site hôte.
#
# Sans ce fichier, les tests ne se lancent pas du tout : ils ne se rabattent pas
# en silence sur un autre moteur. SQLite en mémoire tenait la suite en vingt
# secondes et ne prouvait rien de ce que le schéma promet. Ce paquet en dépend
# plus que la plupart : ses écrans sont des agrégations, donc du GROUP BY, des
# fonctions de date et des index composites, et c'est exactement là que les deux
# moteurs cessent d'être d'accord.

ANALYTICS_TEST_MYSQL_DATABASE=falcon_analytics_test
ANALYTICS_TEST_MYSQL_HOST=127.0.0.1
ANALYTICS_TEST_MYSQL_PORT=3306
ANALYTICS_TEST_MYSQL_USERNAME=root
ANALYTICS_TEST_MYSQL_PASSWORD=
