# The MySQL database the tests run against. The whole suite depends on it.
#
# Copy this file to .env.test, then create the database:
#
#   mysql -u root -p -e "CREATE DATABASE falcon_analytics_test"
#
# The name MUST end in "_test", and the code refuses anything else: the suite
# migrates from scratch, so it drops every table of the database it is pointed
# at. No amount of care taken over the file protects as well as a rule the code
# refuses to break.
#
# It never guesses a database from the host site's configuration.
#
# Without this file the tests do not run at all: they do not quietly fall back
# on another engine. This package's screens are aggregations — GROUP BY, date
# functions and composite indexes — which is exactly where two engines stop
# agreeing, so only MySQL proves what the schema promises.

ANALYTICS_TEST_MYSQL_DATABASE=falcon_analytics_test
ANALYTICS_TEST_MYSQL_HOST=127.0.0.1
ANALYTICS_TEST_MYSQL_PORT=3306
ANALYTICS_TEST_MYSQL_USERNAME=root
ANALYTICS_TEST_MYSQL_PASSWORD=
