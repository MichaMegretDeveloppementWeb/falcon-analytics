# No `includes:`: `phpstan/extension-installer` mounts the installed packages'
# extensions on its own — larastan, Carbon's, and the strict rules. An
# `includes:` written by hand would load them a second time.

parameters:
    # Level 8: the step that refuses to let a possibly null value travel without
    # being checked. The same as the kit's.
    level: 8

    # The strict rules are on, except one.
    #
    # `dynamicCallOnStaticMethod` forbids calling a static method on an
    # instance. Eloquent models its query builder that way: a
    # `$query->whereIn(...)` or a `$query->count()` passes for a static call
    # there, and none of those is a defect. The kit does not meet them — it has
    # no models.
    #
    # The other rules stay. This one comes back on the day the tooling can tell
    # Eloquent's forwarding from a genuine static call on an instance.
    strictRules:
        dynamicCallOnStaticMethod: false

    paths:
        - src
        - tests
        - database
        - config
        - routes

    # Templates read by `analytics:scan-events`, not code to analyse: they name
    # classes that do not exist, to prove the scanner finds an event without
    # resolving anything.
    excludePaths:
        - tests/Fixtures/scan

    # A package has its own config directory, which larastan does not guess:
    # without this, every `env()` in config/analytics.php passes for a call made
    # outside config, which would return null once the config is cached.
    configDirectories:
        - config

    databaseMigrationsPath:
        - database/migrations

    viewDirectories:
        - resources/views

    bootstrapFiles:
        - phpstan-bootstrap.php

    parseModelCastsMethod: true

    # One single process: larastan tries to resolve the container of a Laravel
    # application, which a package does not have, and the parallel worker dies
    # taking the count with it.
    parallel:
        maximumNumberOfProcesses: 1

    # ─── The exceptions, and why they exist ─────────────────────────────────
    #
    # There is no `phpstan-baseline.neon` in this package, and there must not
    # be. What follows hides no debt of the project: these are errors born of
    # two tools meeting, each of which is right.
    #
    # Each is limited to `tests`, and `reportUnmatchedIgnoredErrors` stays on:
    # the day one stops matching, the analysis says so instead of keeping it out
    # of inertia. These are the same as the kit's, under the same conditions for
    # removal.
    ignoreErrors:
        # `$this->artisan()` is declared by Laravel as returning
        # `PendingCommand|int`: the int branch only happens when the command is
        # run without expecting anything of it, which these tests never do since
        # they all chain an assertion.
        # Removed the day Laravel narrows that return type.
        -
            identifier: method.nonObject
            message: '#^Cannot call method .+\(\) on Illuminate\\Testing\\PendingCommand\|int\.$#'
            paths:
                - tests

        # `$this->app` is declared nullable by testbench because it really is
        # outside a test's life cycle: inside a test method, the application is
        # always booted.
        # Removed the day testbench declares it non-null.
        -
            identifier: method.nonObject
            message: '#^Cannot call method .+\(\) on Illuminate\\Foundation\\Application\|null\.$#'
            paths:
                - tests
